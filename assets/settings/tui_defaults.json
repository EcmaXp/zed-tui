{
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "show_edit_predictions": false,
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "show": "never"
  },
  "reduce_motion": "on",
  "terminal": {
    "option_as_meta": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
